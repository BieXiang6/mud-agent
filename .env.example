# 使用前请将本文件复制为 .env，再按实际部署环境替换示例值。
# 请勿提交 .env；所有 VITE_ 开头的变量都会被编译进客户端，不能用于保存真正的秘密。

# 游戏 TCP 默认服务器地址；必填，可填写域名或 IPv4/IPv6 地址。
VITE_GAME_DEFAULT_HOST=localhost
# 游戏 TCP 默认端口；必填，范围为 1–65535。
VITE_GAME_DEFAULT_PORT=4057
# 登录页默认验证码或区服标识；按服务端协议填写，允许留空后由用户输入。
VITE_GAME_DEFAULT_CAPTCHA=
# TCP 建立后发送的握手参数；游戏连接必填，但打包后可被提取，不能视为长期安全密钥。
VITE_GAME_HANDSHAKE_TOKEN=zjmDMaIpOvxdb
# 登录协议要求的客户端标识；游戏连接必填，具体格式由服务端约定。
VITE_GAME_LOGIN_CLIENT_TAG=yourTag
# Android 原生 TCP 连接超时时间，单位为毫秒；允许范围 1000–60000。
VITE_TCP_NATIVE_CONNECT_TIMEOUT_MS=5000
# 非原生 Socket 回退连接的超时时间，单位为毫秒；允许范围 1000–60000。
VITE_TCP_FALLBACK_CONNECT_TIMEOUT_MS=8000

# 客户端查询版本和公告的发布 API 根地址；建议生产环境使用 HTTPS，末尾无需斜杠。
VITE_RELEASE_API_BASE_URL=https://release.example.com
# 客户端请求发布 API 的超时时间，单位为毫秒；允许范围 1000–60000。
VITE_RELEASE_REQUEST_TIMEOUT_MS=5000

# 新建 AI 模型配置时使用的默认 API 根地址；API Key 仍由用户在应用内填写。
VITE_AI_DEFAULT_BASE_URL=https://api.example.com
# 新建 AI 模型配置时使用的默认模型 ID；必须与模型服务商实际提供的 ID 一致。
VITE_AI_DEFAULT_MODEL=your-model-id
# 默认 AI 接口协议；可选 openai-completions 或 openai-responses。
VITE_AI_DEFAULT_PROTOCOL=openai-completions
# 默认模型上下文窗口大小，单位为 Token；允许范围 4096–2000000。
VITE_AI_DEFAULT_CONTEXT_WINDOW=128000
# 默认单次最大输出 Token 数；允许范围 256–1000000，且不应超过模型实际限制。
VITE_AI_DEFAULT_MAX_TOKENS=8192

# 发布信息服务监听地址；0.0.0.0 表示监听全部网卡，生产环境可按网络边界调整。
HOST=0.0.0.0
# 发布信息服务监听端口；应与反向代理、防火墙和客户端发布 API 地址保持一致。
PORT=4058

# Electron Builder 辅助二进制下载镜像；可选，留空时使用工具默认下载源。
ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
